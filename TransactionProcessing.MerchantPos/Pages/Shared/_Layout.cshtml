@{
    var activeNav = (ViewData["ActiveNav"] as string) ?? string.Empty;
    string NavClass(string key) => string.Equals(activeNav, key, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
    var title = (ViewData["Title"] as string) ?? "Merchant POS";
    var dashboardNav = NavClass("dashboard");
    var merchantsNav = NavClass("merchants");
    var configNav = NavClass("config");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @await RenderSectionAsync("Head", required: false)
    <style>
        :root {
            color-scheme: dark;
            --bg: #07111e;
            --panel: rgba(13, 23, 40, 0.96);
            --panel-2: rgba(10, 18, 31, 0.96);
            --line: rgba(151, 182, 216, 0.16);
            --text: #e7effc;
            --muted: #8da3c2;
            --brand: #7ae7c1;
            --brand-2: #6fa8ff;
            --shadow: 0 18px 58px rgba(0, 0, 0, 0.34);
            --radius: 22px;
        }
        * { box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            margin: 0;
            overflow: hidden;
            color: var(--text);
            font-family: Bahnschrift, "Trebuchet MS", "Segoe UI", sans-serif;
            background:
                radial-gradient(circle at top left, rgba(111, 168, 255, 0.22), transparent 26%),
                radial-gradient(circle at right 20%, rgba(122, 231, 193, 0.14), transparent 22%),
                linear-gradient(180deg, #09111d 0%, #07111e 55%, #050910 100%);
        }
        a { color: inherit; text-decoration: none; }
        .shell {
            height: 100vh;
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-width: 1520px;
            margin: 0 auto;
            min-height: 0;
        }
        .nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            padding: 12px 14px;
            border-radius: 20px;
            border: 1px solid var(--line);
            background: rgba(8, 15, 26, 0.72);
            box-shadow: var(--shadow);
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 12px;
            font-weight: 800;
        }
        .brand-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--brand);
            box-shadow: 0 0 0 4px rgba(122, 231, 193, 0.12);
        }
        .nav-links {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .nav-link, .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            border: 1px solid transparent;
            font: inherit;
            cursor: pointer;
            font-weight: 700;
            padding: 11px 15px;
        }
        .nav-link {
            color: var(--text);
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
        }
        .nav-link.active {
            color: #03111b;
            background: linear-gradient(135deg, var(--brand), var(--brand-2));
        }
        .button {
            color: #03111b;
            background: linear-gradient(135deg, var(--brand), var(--brand-2));
        }
        .button.secondary {
            color: var(--text);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.08);
        }
        .message {
            padding: 12px 14px;
            border-radius: 14px;
            background: rgba(122, 231, 193, 0.12);
            border: 1px solid rgba(122, 231, 193, 0.18);
            color: #dbfff0;
            font-size: 13px;
        }
        .page {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .hero {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
            min-height: 0;
        }
        .panel, .card, .stat {
            background: linear-gradient(180deg, var(--panel), var(--panel-2));
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            min-height: 0;
        }
        .panel {
            padding: 18px;
        }
        .hero-main {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 16px;
            padding: 24px;
        }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            width: fit-content;
            padding: 8px 12px;
            border-radius: 999px;
            border: 1px solid rgba(111, 168, 255, 0.18);
            background: rgba(111, 168, 255, 0.12);
            color: #c9dcff;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 12px;
            font-weight: 700;
        }
        .status-dot {
            width: 9px;
            height: 9px;
            border-radius: 999px;
            background: var(--brand);
            box-shadow: 0 0 0 4px rgba(122, 231, 193, 0.12);
        }
        .title {
            margin: 0;
            font-size: clamp(30px, 4vw, 54px);
            line-height: 0.96;
            letter-spacing: -0.05em;
        }
        .subtitle, .section-subtitle, .page-note, .card-copy {
            margin: 0;
            color: var(--muted);
            line-height: 1.55;
            font-size: 14px;
        }
        .hero-meta, .button-row, .chip-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .button-row { justify-content: flex-end; }
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 14px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 13px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            min-height: 0;
        }
        .stat {
            padding: 18px;
        }
        .stat-label {
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin-bottom: 12px;
        }
        .stat-value {
            font-size: 28px;
            line-height: 1;
            letter-spacing: -0.04em;
        }
        .stat-foot {
            margin-top: 10px;
            color: #a9bee0;
            font-size: 13px;
        }
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
        }
        .section-title, .screen-title, .panel-title {
            margin: 0;
            letter-spacing: -0.03em;
        }
        .section-title { font-size: 18px; }
        .screen-title { font-size: 18px; }
        .panel-title { font-size: 16px; margin-bottom: 12px; }
        .table-wrap {
            flex: 1 1 auto;
            min-height: 0;
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .table {
            width: 100%;
            border-collapse: collapse;
        }
        .table th, .table td {
            padding: 12px 10px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            font-size: 14px;
            vertical-align: middle;
        }
        .table th {
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border-radius: 999px;
            font-size: 12px;
            background: rgba(122, 231, 193, 0.12);
            color: #baf5df;
            border: 1px solid rgba(122, 231, 193, 0.18);
        }
        .badge.warn {
            background: rgba(255, 184, 107, 0.12);
            color: #ffd8a8;
            border-color: rgba(255, 184, 107, 0.18);
        }
        .badge.off {
            background: rgba(255, 107, 122, 0.12);
            color: #ffc3cb;
            border-color: rgba(255, 107, 122, 0.18);
        }
        .screen-shell {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .screen-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
        }
        .two-column {
            flex: 1 1 auto;
            min-height: 0;
            display: grid;
            grid-template-columns: 0.28fr 0.72fr;
            gap: 14px;
        }
        .side-panel, .editor-panel, .config-panel {
            padding: 18px;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .merchant-list {
            display: grid;
            gap: 8px;
            min-height: 0;
        }
        .merchant-link {
            display: block;
            padding: 12px 14px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.03);
            color: var(--text);
        }
        .merchant-link.active {
            background: rgba(111, 168, 255, 0.18);
            border-color: rgba(111, 168, 255, 0.35);
        }
        .merchant-link small {
            display: block;
            margin-top: 4px;
            color: var(--muted);
        }
        .stacked-actions { margin-top: auto; }
        .editor-shell {
            flex: 1 1 auto;
            min-height: 0;
            display: grid;
            grid-template-rows: auto 1fr auto;
            gap: 14px;
        }
        .editor-summary {
            padding: 14px;
            border-radius: 18px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: rgba(255, 255, 255, 0.03);
        }
        .fields {
            display: grid;
            gap: 10px 12px;
        }
        .storage-fields {
            grid-template-columns: 1fr;
        }
        .fields-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .fields-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .field {
            display: grid;
            gap: 6px;
        }
        .field label {
            font-size: 12px;
            color: var(--muted);
            letter-spacing: 0.04em;
            text-transform: none;
        }
        .field input {
            width: 100%;
            border: 1px solid rgba(151, 182, 216, 0.16);
            border-radius: 14px;
            background: rgba(4, 10, 20, 0.72);
            color: var(--text);
            padding: 11px 12px;
            font: inherit;
            outline: none;
        }
        .field input[type="text"], .field input[type="password"] {
            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }
        .field-wide {
            grid-column: 1 / -1;
        }
        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-top: 6px;
        }
        .checkbox-label {
            font-size: 14px;
            color: var(--text);
        }
        .config-panel {
            display: grid;
            grid-template-rows: 1fr auto;
            gap: 14px;
        }
        .grid-2 {
            min-height: 0;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }
        .group {
            padding: 16px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            min-height: 0;
        }
        .group h2 {
            margin: 0 0 12px;
            font-size: 16px;
        }
        @@media (max-width: 1200px) {
            .hero, .two-column, .grid-2, .stats-grid { grid-template-columns: 1fr; }
            .fields-2, .fields-3 { grid-template-columns: 1fr 1fr; }
            body { overflow: auto; }
        }
        @@media (max-width: 760px) {
            .shell { padding: 12px; }
            .hero, .two-column, .grid-2, .stats-grid { grid-template-columns: 1fr; }
            .fields-2, .fields-3 { grid-template-columns: 1fr; }
            body { overflow: auto; }
        }
    </style>
</head>
<body>
    <div class="shell">
        <header class="nav">
            <div class="brand"><span class="brand-dot"></span> Merchant POS Control Centre</div>
            <nav class="nav-links" aria-label="Primary">
                <a class="@dashboardNav" href="/">Dashboard</a>
                <a class="@merchantsNav" href="/merchants">Merchant management</a>
                <a class="@configNav" href="/config">Configuration</a>
            </nav>
        </header>
        @RenderBody()
    </div>
</body>
</html>
