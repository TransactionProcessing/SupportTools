<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="appsettings.development.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HealthMonitoring.Client" Version="2026.10.2.55" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
	  <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
	  <PackageReference Include="SecurityService.Client" Version="2026.10.3.207" />
	  <PackageReference Include="Shared" Version="2026.11.2" />
	  <PackageReference Include="Shared.Logger" Version="2026.11.2" />
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	  <PackageReference Include="TransactionProcessor.Client" Version="2026.10.3.427" />
	  <PackageReference Include="TransactionProcessorACL.DataTransferObjects" Version="2026.10.3.166" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="hosting.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
