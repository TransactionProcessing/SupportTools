<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="appsettings.development.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HealthMonitoring.Client" Version="2026.9.3.34" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
	  <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.1" />
	  <PackageReference Include="SecurityService.Client" Version="2026.9.3.183" />
	  <PackageReference Include="Shared" Version="2026.9.7" />
	  <PackageReference Include="Shared.Logger" Version="2026.9.7" />
	  <PackageReference Include="TransactionProcessor.Client" Version="2026.9.3.403" />
	  <PackageReference Include="TransactionProcessorACL.DataTransferObjects" Version="2026.9.3.159" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="hosting.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
