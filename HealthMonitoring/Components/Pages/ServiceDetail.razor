@page "/services/{ServiceId}"
@inject IDashboardQueryService Dashboard

<PageTitle>@(_model?.Service.Name ?? "Service") · Operational Support</PageTitle>
@if (_model is null)
{
    <p class="panel">Service not found.</p>
}
else
{
<div class="page-heading"><div><p class="eyebrow">SERVICE DETAIL · @_model.Service.Environment</p><h1>@_model.Service.Name</h1><p class="muted">@(_model.Service.MonitorType == MonitorType.KurrentDb ? "KurrentDB monitor" : _model.Service.HealthUrl.ToString())</p></div><div><a class="button secondary" href="@($"/services/{ServiceId}/dependencies")">Manage dependency links</a> <a class="button secondary" href="/">Back to overview</a></div></div>
    <div class="detail-status"><StatusBadge Status="@_model.Summary.Status" /> <span>Last checked @( _model.Summary.LastChecked?.ToLocalTime().ToString("dd MMM, HH:mm:ss") ?? "never")</span></div>
    <div class="stat-grid three"><StatCard Label="Uptime (24 hours)" Value="@UptimeText" Class="healthy" /><StatCard Label="Observations" Value="@_model.Observations.Count" Class="neutral" /><StatCard Label="Response" Value="@ResponseText" Class="neutral" /></div>
    <section class="panel"><h2>Status timeline</h2><div class="timeline">@foreach (var observation in _model.Observations.OrderBy(item => item.ObservedAtUtc)) { <span class="timeline-segment @observation.Status.ToString().ToLowerInvariant()" title="@observation.ObservedAtUtc.ToLocalTime()"></span> }</div></section>
    <section class="panel"><h2>Dependency details</h2>@if (_model.Checks.Count == 0) { <p class="muted">No dependency details have been returned.</p> } else { <div class="check-table"><div class="table-heading"><span>Check</span><span>Status</span><span>Duration</span><span>Details</span></div>@foreach (var check in _model.Checks.GroupBy(item => item.Name).Select(group => group.OrderByDescending(item => item.HealthObservationId).First())) { var link = _model.DependencyLinks.FirstOrDefault(item => string.Equals(item.DependencyName.Trim(), check.Name.Trim(), StringComparison.OrdinalIgnoreCase)); <div class="service-row"><div>@if (link is null) { <strong>@check.Name</strong> } else { <a class="dependency-link" href="@($"/services/{link.TargetServiceId}")"><strong>@check.Name</strong> ↗</a> }</div><div><StatusBadge Status="@check.Status" /></div><div>@check.Duration.TotalMilliseconds.ToString("0") ms</div><div>@(check.Description ?? check.Exception ?? "No detail")</div></div>}</div> }</section>
    <details class="panel raw"><summary>Latest raw health response</summary><pre>@(_model.Observations.FirstOrDefault()?.RawResponseJson ?? "No response recorded.")</pre></details>
}

@code {
    [Parameter] public string ServiceId { get; set; } = string.Empty;
    private ServiceDetailModel? _model;
    private string UptimeText => $"{_model?.Summary.UptimePercent:0.00}%";
    private string ResponseText => _model?.Summary.ResponseDuration is { } duration ? $"{duration.TotalMilliseconds:0} ms" : "—";
    protected override async Task OnParametersSetAsync() => _model = await Dashboard.GetServiceDetailAsync(ServiceId, TimeSpan.FromHours(24), CancellationToken.None);
}
