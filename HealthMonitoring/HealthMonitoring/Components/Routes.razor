<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <InitializationGate>
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        </InitializationGate>
    </Found>
    <NotFound>
        <InitializationGate>
            <LayoutView Layout="typeof(Layout.MainLayout)"><p>Page not found.</p></LayoutView>
        </InitializationGate>
    </NotFound>
</Router>
