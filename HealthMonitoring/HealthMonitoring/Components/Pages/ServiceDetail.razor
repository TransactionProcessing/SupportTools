@page "/services/{ServiceId}"
@inject IDashboardQueryService Dashboard

<PageTitle>@(_model?.Service.Name ?? "Service") · Operational Support</PageTitle>
@if (_model is null)
{
    <p class="panel">Service not found.</p>
}
else
{
<div class="page-heading"><div><p class="eyebrow">SERVICE DETAIL · @_model.Service.Environment</p><h1>@_model.Service.Name</h1><p class="muted">@MonitorDescription</p><p class="service-version-detail">Version: <strong>@(string.IsNullOrWhiteSpace(_model.Service.Version) ? "not reported" : _model.Service.Version)</strong></p></div><div><a class="button secondary" href="@($"/services/{ServiceId}/dependencies")">Manage dependency links</a> <a class="button secondary" href="/">Back to overview</a></div></div>
    <div class="detail-status"><StatusBadge Status="@_model.Summary.Status" /> <span>Last checked @( _model.Summary.LastChecked?.ToLocalTime().ToString("dd MMM, HH:mm:ss") ?? "never")</span></div>
    <div class="stat-grid three"><StatCard Label="Uptime (24 hours)" Value="@UptimeText" Class="healthy" /><StatCard Label="Observations" Value="@_model.Observations.Count" Class="neutral" /><StatCard Label="Response" Value="@ResponseText" Class="neutral" /></div>
    <section class="panel"><h2>Status timeline</h2><div class="timeline">@foreach (var observation in TimelineObservationSelector.Select(_model.Observations)) { <span class="timeline-segment @observation.Status.ToString().ToLowerInvariant()" title="@observation.ObservedAtUtc.ToLocalTime()"></span> }</div></section>
    <section class="panel"><h2>Dependency details</h2>@if (_model.Checks.Count == 0) { <p class="muted">No dependency details have been returned.</p> } else { <div class="check-table"><div class="table-heading"><span>Check</span><span>Status</span><span>Duration</span><span>Details</span></div>@foreach (var check in LatestChecks) { var link = _model.DependencyLinks.FirstOrDefault(item => string.Equals(item.DependencyName.Trim(), check.Result.Name.Trim(), StringComparison.OrdinalIgnoreCase)); <div class="service-row"><div>@if (link is null) { <strong>@check.Result.Name</strong> } else { <a class="dependency-link" href="@($"/services/{link.TargetServiceId}")"><strong>@check.Result.Name</strong> ↗</a> }</div><div><StatusBadge Status="@check.Result.Status" /></div><div>@check.Result.Duration.TotalMilliseconds.ToString("0") ms</div><div>@(check.Result.Description ?? check.Result.Exception ?? "No detail")</div></div>}</div> }</section>
    <details class="panel raw"><summary>Latest raw health response</summary><pre>@(_model.Observations.FirstOrDefault()?.RawResponseJson ?? "No response recorded.")</pre></details>
}

@code {
    [Parameter] public string ServiceId { get; set; } = string.Empty;
    private ServiceDetailModel? _model;
    private IEnumerable<ObservedCheck> LatestChecks => _model?.Observations
        .SelectMany(observation => observation.Checks.Select(check => new ObservedCheck(check, observation.ObservedAtUtc)))
        .GroupBy(item => item.Result.Name, StringComparer.OrdinalIgnoreCase)
        .Select(group => group.OrderByDescending(item => item.ObservedAtUtc).First())
        ?? [];
    private string UptimeText => $"{_model?.Summary.UptimePercent:0.00}%";
    private string ResponseText => _model?.Summary.ResponseDuration is { } duration ? $"{duration.TotalMilliseconds:0} ms" : "—";
    private string MonitorDescription => _model?.Service.MonitorType switch
    {
        MonitorType.KurrentDb => "KurrentDB monitor",
        MonitorType.SqlServer => "SQL Server monitor",
        _ => _model?.Service.HealthUrl?.ToString() ?? "HTTP health monitor"
    } ?? "Service monitor";
    protected override async Task OnParametersSetAsync() => _model = await Dashboard.GetServiceDetailAsync(ServiceId, TimeSpan.FromHours(24), CancellationToken.None);

    private sealed record ObservedCheck(HealthCheckResult Result, DateTimeOffset ObservedAtUtc);
}
