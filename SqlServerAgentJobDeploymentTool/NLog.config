<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">

  <variable name="logDirectory" value="${specialfolder:folder=LocalApplicationData}/SqlServerAgentJobDeploymentTool/Logs" />
  <variable name="layout" value="${longdate}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}" />

  <targets>
    <target xsi:type="AsyncWrapper" name="asyncConsole" overflowAction="Block" queueLimit="10000">
      <target xsi:type="Console" name="console" layout="${var:layout}" />
    </target>

    <target xsi:type="AsyncWrapper" name="asyncFile" overflowAction="Discard" queueLimit="50000">
      <target xsi:type="File"
              name="file"
              fileName="${var:logDirectory}/sql-agent-job-deployment.log"
              layout="${var:layout}"
              archiveFileName="${var:logDirectory}/sql-agent-job-deployment.{#####}.log"
              archiveAboveSize="104857600"
              archiveNumbering="Sequence"
              concurrentWrites="true"
              keepFileOpen="false"
              maxArchiveFiles="5" />
    </target>
  </targets>

  <rules>
    <logger name="Microsoft.*" minlevel="Info" writeTo="console,file" final="true" />
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
