<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-MerchantFileProcessor-315512c1-9124-49b4-8877-aa1cbc82076c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FileProcessor.Client" Version="2026.8.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
    <PackageReference Include="SecurityService.Client" Version="2026.8.1" />
    <PackageReference Include="Shared" Version="2026.8.3" />
    <PackageReference Include="Shared.Logger" Version="2026.8.3" />
    <PackageReference Include="Shared.Results" Version="2026.8.3" />
    <PackageReference Include="TransactionProcessor.Client" Version="2026.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="hosting.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="merchant-processing.bootstrap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
